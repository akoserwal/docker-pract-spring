# syntax=docker/dockerfile:1
# LAB 3 (Advanced): Custom Minimal JRE using jlink and Multi-Stage Build
#
# Generates a custom tailored Java 21 runtime containing ONLY the modules
# required by the application, reducing JRE footprint from ~150MB down to ~45MB.

# Stage 1: Build Application
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /build

COPY sample-app/pom.xml .
RUN --mount=type=cache,target=/root/.m2 \
    --mount=type=secret,id=maven-settings,target=/root/.m2/settings.xml,required=false \
    mvn dependency:go-offline -B

COPY sample-app/src ./src
RUN --mount=type=cache,target=/root/.m2 \
    --mount=type=secret,id=maven-settings,target=/root/.m2/settings.xml,required=false \
    mvn package -B

# Stage 2: Create Custom Lightweight JRE with jlink
FROM eclipse-temurin:21-jdk-alpine AS jre-builder
WORKDIR /custom-jre

# Essential modules needed for Spring Boot 3 + web + sql
# (java.base, java.sql, java.naming, java.desktop, java.management, java.security.jgss, java.instrument, jdk.unsupported)
RUN $JAVA_HOME/bin/jlink \
    --add-modules java.base,java.logging,java.xml,jdk.unsupported,java.sql,java.naming,java.desktop,java.management,java.security.jgss,java.instrument,java.net.http,jdk.crypto.ec,jdk.management,java.security.sasl,java.transaction.xa \
    --strip-debug \
    --no-man-pages \
    --no-header-files \
    --compress=2 \
    --output /javaruntime

# Stage 3: Layer Extraction
FROM eclipse-temurin:21-jre-alpine AS extractor
WORKDIR /extracted
COPY --from=builder /build/target/*.jar app.jar
RUN java -Djarmode=layertools -jar app.jar extract --destination /layers

# Stage 4: Minimal Final Runtime (Alpine + Custom JRE)
FROM alpine:3.20 AS runtime
WORKDIR /app
RUN addgroup -S appgroup -g 10001 && adduser -S appuser -u 10001 -G appgroup

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Copy only the custom minimal JRE
COPY --link --from=jre-builder /javaruntime $JAVA_HOME

# Copy application layers
COPY --link --chown=10001:10001 --from=extractor /layers/dependencies/ ./
COPY --link --chown=10001:10001 --from=extractor /layers/spring-boot-loader/ ./
COPY --link --chown=10001:10001 --from=extractor /layers/snapshot-dependencies/ ./
COPY --link --chown=10001:10001 --from=extractor /layers/application/ ./

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
