# syntax=docker/dockerfile:1
# LAB 3: Production Multi-Stage Build
#
# Adheres to official docker-build-strategies:
# - Self-contained (zero host toolchain dependencies: Maven and JDK are in container)
# - Caches Maven dependencies via BuildKit cache mount (/root/.m2)
# - Separates dependency resolution (pom.xml) from source compilation
# - Runtime uses minimal JRE (not full JDK)

# Stage 1: Build Stage
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /build

# 1. Cache dependencies before copying source code
COPY sample-app/pom.xml .
RUN --mount=type=cache,target=/root/.m2 \
    --mount=type=secret,id=maven-settings,target=/root/.m2/settings.xml,required=false \
    mvn dependency:go-offline -B

# 2. Copy source and compile application
COPY sample-app/src ./src
RUN --mount=type=cache,target=/root/.m2 \
    --mount=type=secret,id=maven-settings,target=/root/.m2/settings.xml,required=false \
    mvn package -B

# Stage 2: Layer Extraction Stage
FROM eclipse-temurin:21-jre-alpine AS extractor
WORKDIR /extracted
COPY --from=builder /build/target/*.jar app.jar
RUN java -Djarmode=layertools -jar app.jar extract --destination /layers

# Stage 3: Production Runtime Stage
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app
RUN addgroup -S appgroup -g 10001 && adduser -S appuser -u 10001 -G appgroup

# Non-root user placeholder (expanded in Lab 4)
# Copy layers in order of volatility using BuildKit COPY --link
COPY --link --chown=10001:10001 --from=extractor /layers/dependencies/ ./
COPY --link --chown=10001:10001 --from=extractor /layers/spring-boot-loader/ ./
COPY --link --chown=10001:10001 --from=extractor /layers/snapshot-dependencies/ ./
COPY --link --chown=10001:10001 --from=extractor /layers/application/ ./

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
